{
  "name": "@conductor/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "conductor": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@conductor/client-runtime": "workspace:*",
    "@conductor/contracts": "workspace:*",
    "@conductor/network-guard": "workspace:*",
    "@conductor/provider-acp": "workspace:*",
    "@conductor/provider-core": "workspace:*",
    "@conductor/provider-local-llm": "workspace:*",
    "@conductor/server": "workspace:*",
    "@conductor/web": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  }
}
